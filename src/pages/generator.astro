---
import Layout from "../layouts/Layout.astro";
import { ui } from "../i18n/ui.js";
const locale = (Astro.locals.lang as "en" | "fr") ?? "en";
const t = ui[locale];
---

<Layout title={t.generator.title}>
  <h1 class="text-3xl font-bold mb-6">{t.generator.title}</h1>

  <!-- ton contenu existant (cartes, boutons, script) mais
       tous les libellés viennent de `t.generator.*` -->
  <section class="grid gap-6 md:grid-cols-3">
    <div class="card bg-base-100">
      <div class="card-body">
        <h2 class="card-title">1) {t.generator.promptLabel}</h2>
        <textarea id="user-prompt" class="textarea textarea-bordered h-40"
          placeholder="Ex: A flat minimal icon of a flower with soft gradients"></textarea>
        <div class="flex gap-3 pt-2">
          <button id="generate-button" class="btn btn-primary">{t.generator.generateButton}</button>
          <button id="clear-button" class="btn">{locale === "fr" ? "Effacer" : "Clear"}</button>
        </div>
        <p id="error-msg" class="text-error text-sm mt-2 hidden"></p>
      </div>
    </div>

    <div class="card bg-base-100">
      <div class="card-body">
        <h2 class="card-title">2) {t.generator.codePlaceholder}</h2>
        <pre class="mockup-code overflow-auto max-h-[420px]">
<code id="svg-output">&lt;!-- {t.generator.codePlaceholder} --&gt;</code>
        </pre>
        <div class="flex flex-wrap gap-2">
          <button id="copy-code" class="btn btn-secondary btn-sm">{t.generator.copyButton ?? (locale==="fr"?"Copier":"Copy")}</button>
          <button id="download-svg" class="btn btn-accent btn-sm">{t.generator.downloadButton ?? "Télécharger .svg"}</button>
          <button id="save-svg" class="btn btn-success btn-sm">{t.generator.saveButton ?? "Enregistrer dans PocketBase"}</button>
        </div>
        <p id="save-msg" class="text-sm mt-2"></p>
      </div>
    </div>

    <div class="card bg-base-100">
      <div class="card-body">
        <h2 class="card-title">3) {t.generator.contentPlaceholder}</h2>
        <div id="svg-container" class="w-full aspect-square bg-base-200 grid place-items-center rounded-xl">
          <span class="opacity-60">{t.generator.viewButton}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Garde ton <script> existant ici -->
</Layout>
